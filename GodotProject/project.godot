; JIBON RUNNER — Godot 4 project
config_version=5

[application]
config/name="JIBON RUNNER"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="A Bangladesh-inspired 3D endless runner."

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.45, 0.72, 0.9, 1)
